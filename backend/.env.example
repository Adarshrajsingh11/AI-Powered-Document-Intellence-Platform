NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/documind
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# AI providers.
# "mock" works with NO api key (good for testing the whole flow, answers are not real AI).
# For real answers: LLM_PROVIDER / EMBEDDING_PROVIDER = gemini | openai | anthropic (llm only)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides (leave empty to use defaults)
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
