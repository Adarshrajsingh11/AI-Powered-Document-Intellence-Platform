{
  "name": "documind-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DocuMind AI - AI-powered document intelligence platform (React, Express, MongoDB, RAG)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix ai install && npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix ai test && npm --prefix backend test",
    "smoke": "node infrastructure/scripts/smoke-test.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
